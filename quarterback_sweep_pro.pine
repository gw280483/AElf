//@version=6
indicator("QUARTERBACK SWEEP PRO", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=200)

// INPUTS
refTF = input.timeframe("D", "HTF Range Source")
useRTH = input.bool(false, "Use RTH session boundaries (optional)")
rthSession = input.session("0930-1600", "RTH Session")

requireMidConfirm = input.bool(true, "Require Midpoint Confirm (>= / <= allowed)")
useMomentumConfirm = input.bool(false, "Use Momentum Confirm (optional)")
momLen = input.int(14, "Momentum Length", minval=2)
momMin = input.float(0.0, "Momentum Threshold (abs)", step=0.1)

entryIsTouch = input.bool(true, "Entry Trigger = Touch")
overlayMaxBars = input.int(10, "Overlay Max Bars", minval=1, maxval=10)

showOverlay = input.bool(true, "Show Banner")
showTable = input.bool(true, "Show QB Table")
tblPosOpt = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left", "Top Center", "Bottom Center", "Center"])
tblSizeOpt = input.string("Tiny", "Table Size", options=["Tiny", "Small", "Normal"])

// HELPERS
f_pos(_s) =>
    _s == "Top Left" ? position.top_left :
    _s == "Top Right" ? position.top_right :
    _s == "Bottom Left" ? position.bottom_left :
    _s == "Bottom Right" ? position.bottom_right :
    _s == "Middle Right" ? position.middle_right :
    _s == "Middle Left" ? position.middle_left :
    _s == "Top Center" ? position.top_center :
    _s == "Bottom Center" ? position.bottom_center :
    position.middle_center

f_sz(_s) => _s == "Small" ? size.small : _s == "Normal" ? size.normal : size.tiny
fmt(x) => na(x) ? "—" : str.tostring(x, format.mintick)
touch(_lvl) => low <= _lvl and high >= _lvl

touchOrClose(_lvl, _isTouch) =>
    _isTouch ? touch(_lvl) : ((close >= _lvl and close[1] < _lvl) or (close <= _lvl and close[1] > _lvl))

clamp01(x) => math.min(math.max(x, 0.0), 1.0)

inRTH = not useRTH or not na(time(timeframe.period, rthSession))

// HTF PREV DAY RANGE (25Sense style)
prevDayH = request.security(syminfo.tickerid, refTF, high[1], barmerge.gaps_off, barmerge.lookahead_off)
prevDayL = request.security(syminfo.tickerid, refTF, low[1], barmerge.gaps_off, barmerge.lookahead_off)
prevDayO = request.security(syminfo.tickerid, refTF, open[1], barmerge.gaps_off, barmerge.lookahead_off)

haveHTF = not na(prevDayH) and not na(prevDayL) and prevDayH > prevDayL
htfRng = haveHTF ? math.max(prevDayH - prevDayL, syminfo.mintick) : na
htfMid = haveHTF ? (prevDayL + htfRng * 0.50) : na

entryL = haveHTF ? (prevDayL + htfRng * 0.25) : na
entryS = haveHTF ? (prevDayH - htfRng * 0.25) : na
tp1 = htfMid
tp2L = prevDayH
tp2S = prevDayL

// CURRENT DAY HIGH/LOW (LTF tracking)
newDay = ta.change(time("D")) != 0
var float curDayH = na
var float curDayL = na
if newDay
    curDayH := high
    curDayL := low
else
    curDayH := na(curDayH) ? high : math.max(curDayH, high)
    curDayL := na(curDayL) ? low : math.min(curDayL, low)

// Daily open (current day)
dayOpen = request.security(syminfo.tickerid, "D", open, barmerge.gaps_off, barmerge.lookahead_off)

// SIMPLE SWINGS + EQH/EQL (liquidity sources)
left = 3
right = 3
swingPH = ta.pivothigh(high, left, right)
swingPL = ta.pivotlow(low, left, right)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na

if not na(swingPH)
    prevPH := lastPH
    lastPH := swingPH

if not na(swingPL)
    prevPL := lastPL
    lastPL := swingPL

eqTol = syminfo.mintick * 3.0
eqHigh = (not na(lastPH) and not na(prevPH) and math.abs(lastPH - prevPH) <= eqTol) ? lastPH : na
eqLow = (not na(lastPL) and not na(prevPL) and math.abs(lastPL - prevPL) <= eqTol) ? lastPL : na

// ADR bands
aDrLen = 14
dRange = request.security(syminfo.tickerid, "D", high - low, barmerge.gaps_off, barmerge.lookahead_off)
adr = ta.sma(dRange, aDrLen)
upperADR = not na(dayOpen) and not na(adr) ? dayOpen + adr : na
lowerADR = not na(dayOpen) and not na(adr) ? dayOpen - adr : na

// OPTIONAL MOMENTUM CONFIRM
mom = ta.change(close, momLen)
momOKLong = not useMomentumConfirm or mom >= momMin
momOKShort = not useMomentumConfirm or mom <= -momMin

// NEAREST SWEPT LIQUIDITY with distance output
pickNearestSweptHigh(float pClose) =>
    float best = na
    float bestDist = na
    float c1 = prevDayH
    float c2 = curDayH
    float c3 = lastPH
    float c4 = eqHigh
    float c5 = dayOpen
    float c6 = upperADR

    if not na(c1) and high >= c1 and close < c1
        d = math.abs(c1 - pClose)
        if na(bestDist) or d < bestDist
            best := c1
            bestDist := d
    if not na(c2) and high >= c2 and close < c2
        d = math.abs(c2 - pClose)
        if na(bestDist) or d < bestDist
            best := c2
            bestDist := d
    if not na(c3) and high >= c3 and close < c3
        d = math.abs(c3 - pClose)
        if na(bestDist) or d < bestDist
            best := c3
            bestDist := d
    if not na(c4) and high >= c4 and close < c4
        d = math.abs(c4 - pClose)
        if na(bestDist) or d < bestDist
            best := c4
            bestDist := d
    if not na(c5) and high >= c5 and close < c5
        d = math.abs(c5 - pClose)
        if na(bestDist) or d < bestDist
            best := c5
            bestDist := d
    if not na(c6) and high >= c6 and close < c6
        d = math.abs(c6 - pClose)
        if na(bestDist) or d < bestDist
            best := c6
            bestDist := d

    [best, bestDist]

pickNearestSweptLow(float pClose) =>
    float best = na
    float bestDist = na
    float c1 = prevDayL
    float c2 = curDayL
    float c3 = lastPL
    float c4 = eqLow
    float c5 = dayOpen
    float c6 = lowerADR

    if not na(c1) and low <= c1 and close > c1
        d = math.abs(c1 - pClose)
        if na(bestDist) or d < bestDist
            best := c1
            bestDist := d
    if not na(c2) and low <= c2 and close > c2
        d = math.abs(c2 - pClose)
        if na(bestDist) or d < bestDist
            best := c2
            bestDist := d
    if not na(c3) and low <= c3 and close > c3
        d = math.abs(c3 - pClose)
        if na(bestDist) or d < bestDist
            best := c3
            bestDist := d
    if not na(c4) and low <= c4 and close > c4
        d = math.abs(c4 - pClose)
        if na(bestDist) or d < bestDist
            best := c4
            bestDist := d
    if not na(c5) and low <= c5 and close > c5
        d = math.abs(c5 - pClose)
        if na(bestDist) or d < bestDist
            best := c5
            bestDist := d
    if not na(c6) and low <= c6 and close > c6
        d = math.abs(c6 - pClose)
        if na(bestDist) or d < bestDist
            best := c6
            bestDist := d

    [best, bestDist]

[liqHigh, highDist] = pickNearestSweptHigh(close)
[liqLow, lowDist] = pickNearestSweptLow(close)

haveLiqShort = not na(liqHigh)
haveLiqLong = not na(liqLow)

midOKLong = not requireMidConfirm or (haveHTF and close >= htfMid)
midOKShort = not requireMidConfirm or (haveHTF and close <= htfMid)

// Resolve same-bar conflicts by nearest sweep level
chooseLong = haveLiqLong and (not haveLiqShort or lowDist <= highDist)
chooseShort = haveLiqShort and (not haveLiqLong or highDist < lowDist)

longTriggerBar = inRTH and chooseLong and midOKLong and momOKLong
shortTriggerBar = inRTH and chooseShort and midOKShort and momOKShort

// STATE
// 0 WAIT, 1 LONG TRIGGERED, 2 SHORT TRIGGERED, 3 LONG ACTIVE, 4 SHORT ACTIVE
var int state = 0
var float aEntry = na
var float aTP1 = na
var float aTP2 = na
var float aStop = na
var int trigBar = na
var int wins = 0
var int losses = 0

if longTriggerBar and haveHTF
    state := 1
    aEntry := entryL
    aTP1 := tp1
    aTP2 := tp2L
    aStop := aEntry * 0.875
    trigBar := bar_index

if shortTriggerBar and haveHTF
    state := 2
    aEntry := entryS
    aTP1 := tp1
    aTP2 := tp2S
    aStop := aEntry * 1.125
    trigBar := bar_index

enterLong = state == 1 and not na(aEntry) and touchOrClose(aEntry, entryIsTouch)
enterShort = state == 2 and not na(aEntry) and touchOrClose(aEntry, entryIsTouch)
if enterLong
    state := 3
if enterShort
    state := 4

inLong = state == 3
inShort = state == 4

hitStop = (inLong and not na(aStop) and touch(aStop)) or (inShort and not na(aStop) and touch(aStop))
hitTP2 = (inLong and not na(aTP2) and touch(aTP2)) or (inShort and not na(aTP2) and touch(aTP2))

if inLong or inShort
    if hitStop
        losses += 1
        state := 0
        aEntry := na
        aTP1 := na
        aTP2 := na
        aStop := na
        trigBar := na
    else if hitTP2
        wins += 1
        state := 0
        aEntry := na
        aTP1 := na
        aTP2 := na
        aStop := na
        trigBar := na

total = wins + losses
winRate = total > 0 ? (float(wins) / float(total)) * 100.0 : na

roundedTP1 = na(aTP1) ? na : math.round(aTP1)
suggested = na(roundedTP1) ? "—" : (state == 2 or state == 4 ? ("$" + str.tostring(roundedTP1) + "p") : state == 1 or state == 3 ? ("$" + str.tostring(roundedTP1) + "c") : ("$" + str.tostring(roundedTP1)))

potentialMovePct = (state >= 1 and not na(aEntry) and not na(aTP2)) ? math.abs((aTP2 - aEntry) / aEntry) * 100.0 : na

distToTP2 = (inLong and not na(aTP2) and not na(aEntry)) ? (aTP2 - aEntry) : (inShort and not na(aTP2) and not na(aEntry)) ? (aEntry - aTP2) : na
distNow = (inLong and not na(aEntry)) ? (close - aEntry) : (inShort and not na(aEntry)) ? (aEntry - close) : na

progress = (inLong or inShort) and not na(distToTP2) and distToTP2 != 0 ? clamp01(distNow / distToTP2) : na
progressPct = na(progress) ? na : progress * 100.0

blocks = na(progress) ? 0 : int(math.round(progress * 10.0))
barStr = ""
for i = 0 to 9
    barStr += i < blocks ? "█" : "░"

// Overlay
var box bxMain = na
var box bxStop = na
var label lbEntry = na
var label lbStop = na
var label lbTP1 = na
var label lbTP2 = na

needOverlay = showOverlay and (state >= 1) and not na(trigBar) and not na(aEntry) and not na(aTP2) and not na(aStop)

if not needOverlay
    if not na(bxMain)
        box.delete(bxMain)
    if not na(bxStop)
        box.delete(bxStop)
    if not na(lbEntry)
        label.delete(lbEntry)
    if not na(lbStop)
        label.delete(lbStop)
    if not na(lbTP1)
        label.delete(lbTP1)
    if not na(lbTP2)
        label.delete(lbTP2)
    bxMain := na
    bxStop := na
    lbEntry := na
    lbStop := na
    lbTP1 := na
    lbTP2 := na
else
    leftX = trigBar
    rightX = math.min(trigBar + overlayMaxBars, bar_index)

    topY = math.max(aTP2, aStop)
    botY = math.min(aTP2, aStop)

    if na(bxMain)
        bxMain := box.new(leftX, topY, rightX, botY, bgcolor=color.new(color.green, 82), border_color=color.new(color.green, 0), xloc=xloc.bar_index, extend=extend.none)
        stopTop = math.max(aEntry, aStop)
        stopBot = math.min(aEntry, aStop)
        bxStop := box.new(leftX, stopTop, rightX, stopBot, bgcolor=color.new(color.red, 78), border_color=color.new(color.red, 0), xloc=xloc.bar_index, extend=extend.none)

        lbEntry := label.new(leftX, aEntry, "Entry " + fmt(aEntry), textcolor=color.white, style=label.style_none, size=size.tiny, color=color.new(color.white, 100))
        lbStop := label.new(leftX, aStop, "Stop " + fmt(aStop), textcolor=color.white, style=label.style_none, size=size.tiny, color=color.new(color.white, 100))
        lbTP1 := label.new(leftX, aTP1, "TP1 " + fmt(aTP1), textcolor=color.white, style=label.style_none, size=size.tiny, color=color.new(color.white, 100))
        lbTP2 := label.new(leftX, aTP2, "TP2 " + fmt(aTP2), textcolor=color.white, style=label.style_none, size=size.tiny, color=color.new(color.white, 100))
    else
        box.set_left(bxMain, leftX)
        box.set_right(bxMain, rightX)
        box.set_top(bxMain, topY)
        box.set_bottom(bxMain, botY)

        stopTop = math.max(aEntry, aStop)
        stopBot = math.min(aEntry, aStop)
        box.set_left(bxStop, leftX)
        box.set_right(bxStop, rightX)
        box.set_top(bxStop, stopTop)
        box.set_bottom(bxStop, stopBot)

        label.set_x(lbEntry, leftX)
        label.set_y(lbEntry, aEntry)
        label.set_text(lbEntry, "Entry " + fmt(aEntry))
        label.set_x(lbStop, leftX)
        label.set_y(lbStop, aStop)
        label.set_text(lbStop, "Stop " + fmt(aStop))
        label.set_x(lbTP1, leftX)
        label.set_y(lbTP1, aTP1)
        label.set_text(lbTP1, "TP1 " + fmt(aTP1))
        label.set_x(lbTP2, leftX)
        label.set_y(lbTP2, aTP2)
        label.set_text(lbTP2, "TP2 " + fmt(aTP2))

// TABLE
var table t = na
if showTable and na(t)
    t := table.new(f_pos(tblPosOpt), 4, 7, border_width=1)

if showTable and not na(t)
    table.clear(t, 0, 0, 3, 6)
    ts = f_sz(tblSizeOpt)
    bg = color.new(color.black, 15)
    hdr = color.new(color.black, 0)
    txtBlue = color.rgb(120, 200, 255)

    table.cell(t, 0, 0, "Quarterback Sweep Pro  🏈", text_color=txtBlue, bgcolor=hdr, text_size=ts, text_halign=text.align_center)
    table.cell(t, 1, 0, "", bgcolor=hdr)
    table.cell(t, 2, 0, "", bgcolor=hdr)
    table.cell(t, 3, 0, "", bgcolor=hdr)

    rangeStr = haveHTF ? (fmt(prevDayL) + " - " + fmt(prevDayH)) : "—"
    table.cell(t, 0, 1, "Timeframe", text_color=color.silver, bgcolor=bg, text_size=ts)
    table.cell(t, 1, 1, refTF, text_color=color.white, bgcolor=bg, text_size=ts)
    table.cell(t, 2, 1, "Price Range", text_color=color.silver, bgcolor=bg, text_size=ts)
    table.cell(t, 3, 1, rangeStr, text_color=color.white, bgcolor=bg, text_size=ts)

    statusTxt = state == 0 ? "WAIT" : state == 1 ? "LONG TRIGGERED" : state == 2 ? "SHORT TRIGGERED" : state == 3 ? "LONG ACTIVE" : "SHORT ACTIVE"
    statusCol = state == 0 ? color.yellow : (state == 1 or state == 3) ? color.lime : color.red

    table.cell(t, 0, 2, "Trade Status", text_color=color.silver, bgcolor=bg, text_size=ts)
    table.cell(t, 1, 2, statusTxt, text_color=statusCol, bgcolor=bg, text_size=ts, text_halign=text.align_center)
    table.cell(t, 2, 2, "", bgcolor=bg)
    table.cell(t, 3, 2, "", bgcolor=bg)

    showVals = state >= 1

    table.cell(t, 0, 3, "Entry", text_color=color.silver, bgcolor=bg, text_size=ts)
    table.cell(t, 1, 3, showVals ? fmt(aEntry) : "—", text_color=color.white, bgcolor=bg, text_size=ts)
    table.cell(t, 2, 3, "🛑 Stop", text_color=color.silver, bgcolor=bg, text_size=ts)
    table.cell(t, 3, 3, showVals ? fmt(aStop) : "—", text_color=(hitStop ? color.red : color.white), bgcolor=bg, text_size=ts)

    table.cell(t, 0, 4, "TP1 (50%)", text_color=color.silver, bgcolor=bg, text_size=ts)
    table.cell(t, 1, 4, showVals ? fmt(aTP1) : "—", text_color=color.white, bgcolor=bg, text_size=ts)
    table.cell(t, 2, 4, "TP2 (100%)", text_color=color.silver, bgcolor=bg, text_size=ts)
    table.cell(t, 3, 4, showVals ? fmt(aTP2) : "—", text_color=color.white, bgcolor=bg, text_size=ts)

    progBg = state == 4 ? color.new(color.red, 70) : state == 3 ? color.new(color.green, 70) : bg
    actStr = (inLong or inShort) and not na(progressPct) ? (barStr + " " + str.tostring(progressPct, "#.##") + "%") : "—"
    table.cell(t, 0, 5, "Actual Move", text_color=color.silver, bgcolor=bg, text_size=ts)
    table.cell(t, 1, 5, actStr, text_color=color.white, bgcolor=progBg, text_size=ts, text_halign=text.align_center)
    table.cell(t, 2, 5, "", bgcolor=progBg)
    table.cell(t, 3, 5, "", bgcolor=progBg)

    potStr = showVals and not na(potentialMovePct) ? (str.tostring(potentialMovePct, "#.##") + "%") : "—"
    wrStr = na(winRate) ? "—" : (str.tostring(winRate, "#.##") + "%")

    table.cell(t, 0, 6, "💡 Suggested", text_color=color.silver, bgcolor=bg, text_size=ts)
    table.cell(t, 1, 6, showVals ? suggested : "—", text_color=color.white, bgcolor=bg, text_size=ts)
    table.cell(t, 2, 6, "Potential | Win", text_color=color.silver, bgcolor=bg, text_size=ts)
    table.cell(t, 3, 6, potStr + " | " + wrStr, text_color=color.white, bgcolor=bg, text_size=ts)
